# Copy to backend/.env for local (non-Docker) development.
DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgres://kos:kos@localhost:5432/kos
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email — leave EMAIL_HOST blank in dev to print emails to the console (PRD §22 / D1).
EMAIL_HOST=
DEFAULT_FROM_EMAIL=no-reply@kos.local
FRONTEND_BASE_URL=http://localhost:5173

LOG_LEVEL=INFO

# --- AI automation (apps.ai) ---
# The API key lives here on the server only — it is never sent to the browser
# and is never stored in the database. Leave both blank to run the AI features
# against the offline provider (every screen still works, with stub text).
#
# Set the key for whichever provider AI_PROVIDER names. Note Groq and Grok
# are different vendors despite the near-identical names.
GROQ_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=groq
# Blank uses the provider's own default model (llama-3.3-70b-versatile on Groq,
# grok-4-fast-non-reasoning on xAI, gpt-4o-mini on OpenAI). Set explicitly if
# your account has a different set of models available.
AI_MODEL=
