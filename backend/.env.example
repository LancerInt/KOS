# Copy to backend/.env for local (non-Docker) development.
DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgres://kos:kos@localhost:5432/kos
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email — leave EMAIL_HOST blank in dev to print emails to the console (PRD §22 / D1).
# This governs *all* mail KOS sends: notifications, AI briefings, the emails
# users send from the "Generate email" action, and critical-task alerts.
#
# To send through Gmail, fill in the block below. Two Google-specific points:
#   * EMAIL_HOST_PASSWORD must be a 16-character **app password**, not the
#     account password. Generate one at https://myaccount.google.com/apppasswords
#     (2-Step Verification has to be on before that page appears).
#   * Gmail rewrites the From header to the authenticated account whatever
#     DEFAULT_FROM_EMAIL says. KOS therefore sets Reply-To to the person who
#     sent the message, so replies reach them and not the service mailbox.
#
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@your-domain.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# DEFAULT_FROM_EMAIL=KOS <you@your-domain.com>
EMAIL_HOST=
DEFAULT_FROM_EMAIL=no-reply@kos.local
FRONTEND_BASE_URL=http://localhost:5173

LOG_LEVEL=INFO

# --- AI automation (apps.ai) ---
# The API key lives here on the server only — it is never sent to the browser
# and is never stored in the database. Leave both blank to run the AI features
# against the offline provider (every screen still works, with stub text).
#
# Set the key for whichever provider AI_PROVIDER names. Note Groq and Grok
# are different vendors despite the near-identical names.
GROQ_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=groq
# Blank uses the provider's own default model (openai/gpt-oss-120b on Groq,
# grok-4-fast-non-reasoning on xAI, gpt-4o-mini on OpenAI). Set explicitly if
# your account has a different set of models available — list yours with
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
AI_MODEL=
