# KOS production environment — copy to `.env` at the repo root for
# docker-compose.prod.yml, and fill in real secrets. NEVER commit the real .env.

# --- Django ---
DEBUG=False
DJANGO_SECRET_KEY=generate-a-long-random-50-char-string
DJANGO_ALLOWED_HOSTS=kos.your-domain.com
CORS_ALLOWED_ORIGINS=https://kos.your-domain.com
SECURE_SSL_REDIRECT=True

# --- Data ---
POSTGRES_PASSWORD=set-a-strong-db-password

# --- Email (SMTP) — leave EMAIL_HOST blank to log emails to the console ---
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@your-domain.com

# --- Frontend links in notification emails ---
FRONTEND_BASE_URL=https://kos.your-domain.com

# --- AI automation (apps.ai) ---
# Server-side only: the key never reaches the browser and is never stored in the
# database. It must be present for the API *and* the Celery worker/beat
# containers — the scheduled automations run there.
#
# Leaving both blank does not break anything: the AI falls back to the offline
# provider and every screen keeps working with placeholder text.
GROQ_API_KEY=your-groq-api-key
GROK_API_KEY=
OPENAI_API_KEY=
# Switch the whole system to another vendor by changing this one value
# (plus its key): groq | grok | openai | mock.
AI_PROVIDER=groq
# Blank uses the provider's own default model.
AI_MODEL=
